<template>
  <div class="page" onclick="onTap" onlongpress="toggleImmersive" onswipe="blockSwipe">
  <!-- .viewport 按视口边缘铺满（right/bottom:0），把内容裁在里面。
       不能用算出来的宽高 —— 那个数值一旦和真实视口不一致，界面就能滑动（红米上踩过）。 -->
  <div class="viewport">

    <!-- 背景层：一张宽图 + 定时器小步推进 left 做平移。
         不用 CSS transition、不用 swiper —— 那两个在真机上都不行，
         详见下方 BG_PAN_RANGE 附近的说明。

         外面必须套一个 overflow:hidden 的裁切容器：宽图是 672、屏幕只有 336，
         不裁住的话运行时会把这个页面当成"内容比视口宽"的横向可滚动区域，
         玩家一拖就把整个背景拖走。**只给 .page 加 overflow 不够保险**
         （根节点是页面本身，运行时不一定会把它当普通容器处理），
         所以这里用一个明确的子容器再裁一层。 -->
    <div class="bgclip" style="{{bgClipStyle}}" onswipe="blockSwipe">
      <image class="bgwide" style="{{bgStyle}}" src="{{bgSrc}}" if="{{bgSrc}}" onswipe="blockSwipe"></image>
    </div>
    <div class="solid" style="{{fullStyle}}" if="{{showBlack}}"></div>
    <div class="solid-white" style="{{fullStyle}}" if="{{showWhite}}"></div>

    <!-- 立绘层（三个固定槽位，避免动态节点） -->
    <image class="sp sp-l" style="{{spStyleL}}" src="{{spL}}" if="{{spL}}" onswipe="blockSwipe"></image>
    <image class="sp sp-c" style="{{spStyleC}}" src="{{spC}}" if="{{spC}}" onswipe="blockSwipe"></image>
    <image class="sp sp-r" style="{{spStyleR}}" src="{{spR}}" if="{{spR}}" onswipe="blockSwipe"></image>

    <!-- CG 层 -->
    <image class="layer" style="{{fullStyle}}" src="{{cgSrc}}" if="{{cgSrc}}" onswipe="blockSwipe"></image>

    <!-- 回忆滤镜 -->
    <div class="tint" style="{{fullStyle}}" if="{{tint}}" onswipe="blockSwipe"></div>

    <!-- 顶部信息条 -->
    <div class="hud" style="{{hudStyle}}" if="{{!uiHidden && !endText}}">
      <text class="hud-t" style="{{hudTStyle}}">{{chapterTitle}}</text>
      <text class="hud-p" style="{{hudPStyle}}">{{progress}}</text>
    </div>
    <div class="menu-btn" style="{{mbStyle}}" if="{{!uiHidden && !endText}}" onclick="openMenu" onswipe="blockSwipe">
      <text class="menu-ico" style="{{mbIcoStyle}}">≡</text>
    </div>

    <!-- 对白面板（出现选项时收起，避免空框）；看 CG 时压得更透，让画面露出来 -->
    <div class="panel" style="{{panelStyle}}" if="{{!uiHidden && !endText && !choices.length && !cgSrc}}" onswipe="blockSwipe"></div>
    <div class="panel-cg" style="{{panelStyle}}" if="{{!uiHidden && !endText && !choices.length && cgSrc}}" onswipe="blockSwipe"></div>
    <text class="name" style="{{nameStyle}}" if="{{!uiHidden && !endText && !choices.length && speaker}}" onswipe="blockSwipe">{{speaker}}</text>
    <!-- 正文：6 个固定槽位，行高/字号/位置由 s0..s5 动态给出（字号可无级调） -->
    <text class="ln" style="{{s0}}" if="{{!uiHidden && !endText && !choices.length}}">{{l0}}</text>
    <text class="ln" style="{{s1}}" if="{{!uiHidden && !endText && !choices.length}}">{{l1}}</text>
    <text class="ln" style="{{s2}}" if="{{!uiHidden && !endText && !choices.length}}">{{l2}}</text>
    <text class="ln" style="{{s3}}" if="{{!uiHidden && !endText && !choices.length}}">{{l3}}</text>
    <text class="ln" style="{{s4}}" if="{{!uiHidden && !endText && !choices.length}}">{{l4}}</text>
    <text class="ln" style="{{s5}}" if="{{!uiHidden && !endText && !choices.length}}">{{l5}}</text>

    <!-- 继续提示 -->
    <text class="more" style="{{moreStyle}}" if="{{!uiHidden && !endText && !choices.length && canTap}}">▼</text>

    <!-- 运行状态徽标：做成小块而不是全屏遮罩，任何情况下都不会挡住画面 -->
    <text class="badge" style="{{badgeStyle}}" if="{{badge}}">{{badge}}</text>

    <!-- 分支选择 -->
    <div class="choices" style="{{choicesStyle}}" if="{{choices.length}}">
      <text class="choice" for="{{choices}}" tid="cid" onclick="pickChoice($idx)" onswipe="blockSwipe">{{$item.x}}</text>
    </div>

    <!-- 结局 -->
    <div class="ending" if="{{endText}}">
      <text class="end-title">{{endText}}</text>
      <text class="end-tip">轻触返回标题</text>
    </div>

    <!-- 阅读菜单 -->
    <div class="menu" if="{{menu}}">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-sub">{{chapterTitle}} · {{progress}}</text>
      <div class="mbtn mbtn-main" onclick="closeMenu" onswipe="blockSwipe"><text class="mbtn-t">继续阅读</text></div>
      <div class="mbtn" onclick="goSave" onswipe="blockSwipe"><text class="mbtn-t">保存进度</text></div>
      <div class="mbtn" onclick="goLoad" onswipe="blockSwipe"><text class="mbtn-t">读取存档</text></div>
      <div class="mbtn" onclick="toggleAuto" onswipe="blockSwipe"><text class="mbtn-t">自动播放：{{autoOn ? '开' : '关'}}</text></div>
      <div class="mbtn" onclick="toggleFast" onswipe="blockSwipe"><text class="mbtn-t">快进：{{fastOn ? '开' : '关'}}</text></div>
      <div class="mbtn" onclick="nextChapter" onswipe="blockSwipe"><text class="mbtn-t">跳到下一章</text></div>
      <div class="mrow">
        <div class="mbtn mbtn-half" onclick="goChapters" onswipe="blockSwipe"><text class="mbtn-t">章节</text></div>
        <div class="mbtn mbtn-half" onclick="goCg" onswipe="blockSwipe"><text class="mbtn-t">CG</text></div>
      </div>
      <div class="mrow">
        <div class="mbtn mbtn-half" onclick="goSettings" onswipe="blockSwipe"><text class="mbtn-t">设置</text></div>
        <div class="mbtn mbtn-half" onclick="goHome" onswipe="blockSwipe"><text class="mbtn-t">主页</text></div>
      </div>
      <div class="mbtn mbtn-quit" onclick="quit" onswipe="blockSwipe"><text class="mbtn-t">退出</text></div>
    </div>

    </div><!-- /.viewport -->
  </div>
</template>

<style>
  /* overflow:hidden 是必须的：背景图有 672 宽，是屏幕的两倍。
     不裁住的话运行时会把这个页面当成"内容比视口宽"的横向可滚动区域，
     玩家一拖就把整个背景拖走（真机上出现过这个现象）。 */
  /* ⚠️ .page 用 right/bottom 铺满视口，**不要**用算出来的宽高。
     踩过：红米手表上「界面能上下滑」—— 因为引擎按探测到的屏幕尺寸算出设计高，
     而运行时的视口高是按真实屏幕算的；两者一旦不同源，内容就比视口高，
     运行时就把它当成可滚动内容。用 bottom:0 锚在视口边缘就与数值无关了。 */
  .page {
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;
    bottom: 0px;
    background-color: #000000;
    overflow: hidden;
  }

  /* 内容和 .page 之间再夹一层裁切容器，同样按视口边缘定位。
     两层都裁住，任何一层生效就滚不动。 */
  .viewport {
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;
    bottom: 0px;
    overflow: hidden;
  }

  .layer { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px; object-fit: cover; }

  /* 全景背景：比屏幕宽 BG_PAN_RANGE 的一张宽图，left 由定时器小步推进。
     两层保险：
       1) .bgclip 是明确的裁切容器（overflow:hidden），把 672 宽的图裁在 336 里
       2) .page 上也有 overflow:hidden
     不要给 .bgwide 加 transition —— 真机上会渲染出重影/接缝。 */
  .bgclip { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px;
            overflow: hidden; }
  .bgwide { position: absolute; top: 0px; left: 0px; width: 672px; height: 480px;
            object-fit: fill; }
  .solid { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px; background-color: #000000; }
  .solid-white { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px; background-color: #ffffff; }

  .sp { position: absolute; width: 143px; height: 380px; object-fit: contain; top: 100px; }
  .sp-l { left: 10px; }
  .sp-c { left: 96px; }
  .sp-r { left: 182px; }

  /* 注意：全部半透明一律用 rgba 背景色，不要用 opacity。
     opacity 会让运行时把整棵子树离屏合成，手环固件上会把带子节点的容器画成横向条纹 */
  .tint { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px;
          background-color: rgba(240, 222, 176, 0.22); }

  .hud { position: absolute; top: 10px; left: 12px; height: 26px; padding-left: 10px; padding-right: 10px;
         border-radius: 13px; background-color: rgba(0, 0, 0, 0.55);
         flex-direction: row; align-items: center; }
  .hud-t { font-size: 17px; color: #ffe6ef; }
  .hud-p { font-size: 15px; color: #b9b0b6; margin-left: 8px; }

  /* 右上角菜单按钮：原来 36x36 太小，手环上不好点。
     放大到 52x52（贴右边缘留 6px 外边距），图标也放大。 */
  .menu-btn { position: absolute; top: 6px; left: 278px; width: 52px; height: 52px; border-radius: 26px;
              background-color: rgba(27, 21, 32, 0.82); align-items: center; justify-content: center; }
  .menu-ico { font-size: 30px; color: #ffd8e6; }

  /* 底板 330..480。说话人单独浮在底板上方（298），不再贴着底板边缘。
     两种底板用同一套几何：只改透明度，避免看 CG 时底板下移、说话人半悬在边缘上。 */
  .panel { position: absolute; top: 330px; left: 0px; width: 336px; height: 150px;
           background-color: rgba(18, 13, 19, 0.80); }
  /* 看 CG 时用更透的底板，把画面尽量露出来 */
  .panel-cg { position: absolute; top: 330px; left: 0px; width: 336px; height: 150px;
              background-color: rgba(10, 8, 12, 0.58); }

  /* 说话人：自带一块跟着文字宽度走的半透明底板（靠 text 的 padding+background 实现，
     不需要固定宽度），浮在底板上方，不再贴着底板上沿，也不会被亮色画面糊掉 */
  .name { position: absolute; top: 292px; left: 12px; font-size: 20px; color: #ffd8e6;
          font-weight: bold; background-color: rgba(16, 11, 18, 0.74);
          padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px;
          border-radius: 9px; text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.9); }

  /* 正文行：位置/字号/行高都在 s0..s5 里动态给出，见 applyFont()。
     正文区 316×134，运行时按当前字号算每行字数与行数，所以不会折行。 */
  .ln { position: absolute; left: 10px; width: 316px; color: #ffffff;
        font-size: 20px; line-height: 24px; lines: 1; }

  .more { position: absolute; top: 462px; left: 308px; font-size: 16px; color: #ff9ec4; }

  .badge { position: absolute; top: 44px; left: 12px; width: 312px; font-size: 15px; line-height: 20px;
           color: #ffd166; lines: 3; }

  .choices { position: absolute; top: 96px; left: 16px; width: 304px; flex-direction: column; }
  .choice { width: 304px; min-height: 52px; margin-bottom: 8px; padding: 10px; border-radius: 12px;
            background-color: rgba(36, 26, 43, 0.94); color: #ffe6ef; font-size: 19px; line-height: 26px; }

  .ending { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px;
            background-color: #07060a; flex-direction: column; align-items: center; justify-content: center; }
  .end-title { font-size: 26px; color: #ffe6ef; text-align: center; width: 280px; line-height: 36px; }
  .end-tip { font-size: 17px; color: #7d757f; margin-top: 26px; }

  .menu { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px;
          background-color: #140f17; flex-direction: column; align-items: center; padding-top: 14px; }
  .menu-title { font-size: 24px; color: #ffd8e6; font-weight: bold; }
  .menu-sub { font-size: 15px; color: #a4979f; margin-top: 4px; margin-bottom: 10px; }
  /* 菜单有 6 个整行 + 2 行双按钮 + 退出，按 36px 高 / 5px 间距刚好装进 480 */
  .mbtn { width: 240px; height: 36px; border-radius: 18px; background-color: #2c2133;
          align-items: center; justify-content: center; margin-bottom: 5px; }
  .mbtn-main { background-color: #b95079; }
  .mbtn-quit { background-color: #241a2b; margin-top: 4px; }
  .mbtn-t { font-size: 17px; color: #ffffff; }
  .mrow { width: 240px; flex-direction: row; justify-content: space-between; }
  .mbtn-half { width: 116px; }
</style>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'
import file from '@system.file'
import brightness from '@system.brightness'
import { IMG } from '../../common/assets.js'
import { currentLayout, onLayoutReady } from '../../common/geo.js'
import { textMetrics } from '../../common/layout.js'
import {
  DEFAULT_SETTINGS, autoDelay, loadSettings, saveSettings, paginateText,
  loadAutoSave, saveAutoSave, loadSeen, saveSeen, loadCleared, markCleared
} from '../../common/reader.js'

const SAVE_MAGIC = 'yurite-1'
const TAG = '[Yurite] '

// ---------------------------------------------------------------- 正文区几何
// **纵向几何全部由 common/layout.js 按屏幕实际比例算出来**，这里不再写死。
// 设计坐标系宽度固定 336，高度 = 336 × 屏幕高/屏幕宽：
//   手环 9/10 Pro  336×480 -> 设计高 480
//   手环 10 标准版 212×520 -> 设计高 824
//   手环 9 标准版  192×490 -> 设计高 858
// H=480 时 layout.js 算出来的值与老版本逐像素一致（tools/test_layout.mjs 会核对）。
//
// 每次排版都从 this.lay 现取，不缓存成模块常量 —— 屏幕尺寸是异步探测出来的，
// 探测完成后要能用新尺寸重排一次。
const TEXT_PAD = 6        // 每行右侧留的余量（算每行字数用）
const MAX_LINES = 6       // .ln 的槽位数量，必须 >= 字号 14 时的行数

// ---------------------------------------------------------------- 全景背景
// 背景是一张 BG_W 宽的宽图，显示框只有屏幕宽，靠**定时器小步推进 left** 做平移。
//
// 为什么不用更"聪明"的两条路（都在真机上失败，记下来免得再踩）：
//   1) 宽图 + left + CSS transition 平移 → 画面中间出竖向接缝，
//      接缝位置正好等于平移距离，疑似过渡中间态被渲染成两个位置叠加
//   2) 预切整屏图块 + <swiper autoplay> 轮播 → 幻灯片不贴合（中间留黑带）、
//      另一版里整个画面还被放大
// left 本身是能正确渲染的（方案 1 里画面位置就是对的，坏的只是 transition 补间），
// 所以这里自己按固定间隔推进 left，**完全不碰 transition**。
//
// 步长 4px / 100ms = 40px/s，扫完 336px 约 8.4 秒。
// 步子再小也不会更顺（这是 10fps 的离散推进），再大就会看出跳。
//
// BG_W 在设计坐标里恒为 672：素材是按「2 倍屏宽」出的，设计宽也恒为 336，
// 两者同比例，所以**在所有型号上都是 2 屏宽**，不用按型号改。
const BG_W = 672
const BG_PAN_RANGE = BG_W - 336   // 可平移距离
const BG_STEP_PX = 4       // 每帧推进多少像素
const BG_TICK_MS = 100     // 每帧间隔（10fps）
const AUTO_DEFAULT = 90    // 从菜单打开自动播放时给的默认停留（毫秒/字）

export default {
  // ⚠️ Vela 运行时硬性规定：data 与 public/protected/private 不能同时存在，
  // 同时写会直接抛 "页面VM对象中的属性data不可与public,protected,private同时存在"，
  // 页面 VM 创建失败 → 点了按钮没任何反应。
  // 本工程统一只用 protected：既能接路由参数（load/auto/at），又充当页面数据模型。
  protected: {
    // —— 路由参数（应用内传参必须在此声明才会被写入）
    load: '',
    auto: '',
    at: '',

    // —— 参与界面绑定的状态
    badge: '',                 // 运行状态徽标（加载中/出错写这里，不挡画面）
    chapterTitle: '——',
    progress: '0%',
    bgSrc: '', showBlack: true, showWhite: false,
    spL: '', spC: '', spR: '',
    cgSrc: '',
    tint: '',
    speaker: '',
    l0: '', l1: '', l2: '', l3: '', l4: '', l5: '',
    s0: '', s1: '', s2: '', s3: '', s4: '', s5: '',
    bgStyle: '',
    // —— 自适应几何：由 common/layout.js 按屏幕实际尺寸算出，全部在设计坐标（宽恒 336）
    lay: currentLayout(),
    bgClipStyle: '', fullStyle: '',
    spStyleL: '', spStyleC: '', spStyleR: '',
    hudStyle: '', hudTStyle: '', hudPStyle: '',
    mbStyle: '', mbIcoStyle: '',
    panelStyle: '', nameStyle: '', moreStyle: '',
    choicesStyle: '', menuStyle: '', badgeStyle: '',
    canTap: false,
    choices: [],
    menu: false,
    uiHidden: false,
    endText: '',
    autoOn: false,
    fastOn: false
  },

  // ---------------------------------------------------------------- 生命周期
  onInit() {
    // 自适应几何：先用当前已知的屏幕尺寸排一次（同步路径可能已经拿到真实尺寸），
    // 异步探测回来后再重排一次。放最前面，后面所有依赖几何的初始化才能用上。
    this.applyGeometry()
    onLayoutReady(() => {
      this.applyGeometry()
      // 几何变了，正在打字/自动播放的那一屏要按新的行数重新分页
      if (this.rawText) this.playPage()
    })

    // 非绑定状态一律在 onInit 里显式初始化，避免多页面实例之间共享同一个对象
    this.story = null
    this.pc = 0
    this.flags = {}
    this.chunkStart = -1
    this.chunkNodes = null
    this.chunkCache = {}
    this.chunkPending = {}
    this.pages = [['']]
    this.rawText = ''
    this.pageIdx = 0
    this.pageText = ''
    this.typing = 0
    this.typingToken = 0
    this.typingAt = 0
    this.timer = null
    this.autoTimer = null
    this.saveTimer = null
    this.bgTimer = null
    this.bgOffset = 0
    this.bgDir = 1
    this.advanceCount = 0
    this.csRaw = []
    this.settings = DEFAULT_SETTINGS
    this.lockTap = 0
    // CG 鉴赏解锁记录：看到过的 CG 图片下标（对应原作的 seen_image）
    this.seenIdx = {}
    this.seenList = []
    this.seenTimer = null
    this.cleared = false
    loadCleared((ok) => { this.cleared = ok })
    loadSeen((list) => {
      this.seenList = list.slice()
      for (let i = 0; i < this.seenList.length; i++) this.seenIdx[this.seenList[i]] = 1
    })

    this.log('onInit，参数 at=' + this.at + ' load=' + this.load + ' auto=' + this.auto)
    try {
      loadSettings((s) => {
        this.settings = s
        this.autoOn = s.autoMs > 0
        this.fastOn = !!s.fast
        this.applyFont()
        this.applyScreenKeepOn()
        this.log('设置已载入 size=' + s.size + ' speed=' + s.speed +
                 ' auto=' + s.autoMs + ' fast=' + s.fast + ' keepOn=' + s.keepOn)
        this.bootstrap()
      })
    } catch (e) {
      this.fail('onInit', e)
    }
    // 看门狗：8 秒还没出内容就把内部状态显示出来，方便定位
    this.watch = setTimeout(() => {
      if (!this.pageText && !this.endText) {
        this.badge = '卡在: ' + (this.dbg || '未知阶段')
        this.log('看门狗触发 ' + this.badge)
      }
    }, 8000)
  },

  onShow() {
    // 从设置页回来时把新设置应用上
    loadSettings((s) => {
      this.settings = s
      this.autoOn = s.autoMs > 0
      this.fastOn = !!s.fast
      this.applyFont()
      this.applyScreenKeepOn()
    })
    // 从别的页面切回来时，背景轮播和屏幕常亮都要重新生效
    if (this.bgSrc) this.startBgPan()
    if (this.pageText) {
      this.typingToken++
      this.renderTyping(this.pageText.length)
    }
  },
  onHide() {
    this.clearTimers()
    this.setKeepScreenOn(false)
    this.flushAutoSave()
    this.flushSeen()
  },
  onDestroy() {
    this.clearTimers()
    this.setKeepScreenOn(false)
    this.flushAutoSave()
    this.flushSeen()
    if (this.watch) { clearTimeout(this.watch); this.watch = null }
    this.chunkCache = {}
    this.chunkPending = {}
    this.chunkNodes = null
    this.story = null
  },
  onBackPress() {
    if (this.menu) { this.menu = false; return true }
    this.menu = true
    this.clearAuto()
    return true
  },

  // ---------------------------------------------------------------- 日志与错误
  log(msg, force) {
    this.dbg = msg
    // 只有还没出内容时（首次载入）才把状态显示在屏幕上，正常阅读时不打扰
    if (force || !this.pageText) this.badge = msg
    try { console.log(TAG + msg) } catch (e) {}
  },
  fail(where, e) {
    const msg = where + ' 出错: ' + (e && e.message ? e.message : e)
    this.badge = msg
    try { console.error(TAG + msg) } catch (err) {}
  },

  // ---------------------------------------------------------------- 启动
  bootstrap() {
    try {
      this.readIndex()
    } catch (e) {
      this.fail('bootstrap', e)
    }
  },

  readIndex() {
    this.log('读取剧本索引…')
    file.readText({
      uri: '/common/story/index.txt',
      success: (data) => {
        try {
          const idx = JSON.parse(data.text)
          if (!idx || !idx.chunks || !idx.chapters) {
            this.badge = '剧本索引损坏'
            this.log('索引字段缺失')
            return
          }
          this.story = idx
          this.flags = {}
          this.log('索引 OK：节点 ' + idx.nodeCount + '，分块 ' + idx.chunks.length)
          this.afterIndex()
        } catch (e) {
          this.fail('解析索引', e)
        }
      },
      fail: (d, code) => {
        this.badge = '读不到剧本索引 (code ' + code + ')'
        this.log('索引读取失败 code=' + code)
      }
    })
  },

  afterIndex() {
    const at = this.at === undefined || this.at === null ? '' : String(this.at)
    const load = this.load === undefined || this.load === null ? '' : String(this.load)
    const auto = this.auto === undefined || this.auto === null ? '' : String(this.auto)

    if (at !== '') {
      let target = parseInt(at, 10)
      if (!(target >= 0)) target = 0
      this.log('按章节跳转 -> 节点 ' + target)
      this.goto(target)
      return
    }
    loadAutoSave((autoData) => {
      try {
        if (load !== '') {
          this.restoreFromSlot(parseInt(load, 10))
        } else if (auto === '1' && autoData && autoData.magic === SAVE_MAGIC) {
          this.log('从自动存档继续')
          this.applySave(autoData)
        } else {
          this.log('从序章开始')
          this.goto(0)
        }
      } catch (e) {
        this.fail('afterIndex', e)
      }
    })
  },

  restoreFromSlot(slot) {
    if (!(slot >= 0)) { this.goto(0); return }
    this.log('读取存档槽 ' + slot)
    storage.get({
      key: 'saves',
      default: '',
      success: (v) => {
        try {
          const list = v ? JSON.parse(v) : []
          const d = list[slot]
          if (!d || d.magic !== SAVE_MAGIC) {
            this.badge = '存档不存在'
            this.goto(0)
            return
          }
          this.applySave(d)
        } catch (e) {
          this.fail('读档', e)
          this.goto(0)
        }
      },
      fail: () => this.goto(0)
    })
  },

  applySave(data) {
    this.flags = data.flags || {}
    this.bgSrc = data.bgSrc || ''
    this.showBlack = !!data.showBlack
    this.showWhite = !!data.showWhite
    this.csRaw = data.cs || []
    this.renderSprites(this.csRaw)
    this.cgSrc = data.cgSrc || ''
    this.tint = data.tint || ''
    this.goto(data.pc || 0)
  },

  collectSave() {
    return {
      magic: SAVE_MAGIC,
      pc: this.pc,
      chapter: this.chapterIndex(),
      flags: Object.assign({}, this.flags),
      bgSrc: this.bgSrc,
      showBlack: this.showBlack,
      showWhite: this.showWhite,
      cs: this.csRaw.slice(),
      cgSrc: this.cgSrc,
      tint: this.tint,
      text: this.previewText(),
      at: Date.now()
    }
  },

  previewText() {
    const t = String(this.pageText || this.l0 || '').split('\n')[0]
    return t.length > 24 ? t.slice(0, 24) + '…' : t
  },

  chapterIndex() {
    if (!this.story) return 0
    const list = this.story.chapters
    let cur = 0
    for (let i = 0; i < list.length; i++) if (this.pc >= list[i].start) cur = i
    return cur
  },

  updateHud() {
    if (!this.story) return
    const list = this.story.chapters
    const i = this.chapterIndex()
    const ch = list[i]
    if (!ch) { this.chapterTitle = '——'; this.progress = '0%'; return }
    this.chapterTitle = ch.title
    const end = list[i + 1] ? list[i + 1].start : this.story.nodeCount
    const span = Math.max(1, end - ch.start)
    const done = Math.max(0, this.pc - ch.start)
    this.progress = Math.min(99, Math.round(done * 100 / span)) + '%'
  },

  // ---------------------------------------------------------------- 分块调度
  chunkOf(index) {
    const list = this.story.chunks
    for (let i = 0; i < list.length; i++) {
      const c = list[i]
      if (index >= c.start && index < c.start + c.count) return c
    }
    return null
  },

  inChunk(index) {
    return !!this.chunkNodes && this.chunkStart >= 0 &&
      index >= this.chunkStart && index < this.chunkStart + this.chunkNodes.length
  },

  readChunk(chunk, done) {
    // 自愈：万一框架没有把 onInit 里设好的状态保留下来，这里补上，
    // 避免 undefined[...] 抛异常把加载流程整个打断
    if (!this.chunkCache) this.chunkCache = {}
    if (!this.chunkPending) this.chunkPending = {}
    const cached = this.chunkCache[chunk.start]
    if (cached) { done(cached); return }
    const wait = this.chunkPending[chunk.start]
    if (wait) { wait.push(done); return }
    this.chunkPending[chunk.start] = [done]
    const finish = (nodes, err) => {
      const list = this.chunkPending[chunk.start] || []
      delete this.chunkPending[chunk.start]
      if (err || !nodes) {
        for (let i = 0; i < list.length; i++) { try { list[i](null) } catch (e) {} }
        return
      }
      this.chunkCache[chunk.start] = nodes
      for (let i = 0; i < list.length; i++) { try { list[i](nodes) } catch (e) {} }
    }
    file.readText({
      uri: chunk.file,
      success: (data) => {
        try {
          const nodes = JSON.parse(data.text)
          if (!nodes || nodes.length !== chunk.count) {
            this.badge = '分块长度不符 ' + chunk.file
            finish(null, true)
            return
          }
          this.log('分块 OK ' + chunk.file + ' (' + nodes.length + ' 节点)')
          finish(nodes)
        } catch (e) {
          this.fail('解析分块 ' + chunk.file, e)
          finish(null, true)
        }
      },
      fail: (d, code) => {
        this.badge = '读不到分块 ' + chunk.file + ' (code ' + code + ')'
        this.log('分块读取失败 ' + chunk.file + ' code=' + code)
        finish(null, true)
      }
    })
  },

  trimCache(index) {
    const cur = this.chunkOf(index)
    if (!cur) return
    const list = this.story.chunks
    const pos = list.indexOf(cur)
    const keep = {}
    keep[cur.start] = 1
    if (pos >= 0 && list[pos + 1]) keep[list[pos + 1].start] = 1
    for (const k in this.chunkCache) if (!keep[k]) delete this.chunkCache[k]
  },

  prefetch(index) {
    const cur = this.chunkOf(index)
    if (!cur) return
    const list = this.story.chunks
    const pos = list.indexOf(cur)
    const next = pos >= 0 ? list[pos + 1] : null
    if (!next || this.chunkCache[next.start]) return
    this.readChunk(next, () => {})
  },

  goto(index) {
    try {
      if (!this.story) { this.badge = '剧本未载入'; return }
      if (!(index >= 0) || index >= this.story.nodeCount) {
        this.badge = '节点越界 ' + index
        this.finishAll()
        return
      }
      this.pc = index
      if (this.inChunk(index)) { this.step(); return }
      const chunk = this.chunkOf(index)
      if (!chunk) { this.badge = '找不到节点 ' + index + ' 所属分块'; return }
      this.log('读取分块 ' + chunk.file + ' …')
      this.readChunk(chunk, (nodes) => {
        if (!nodes) return
        this.chunkNodes = nodes
        this.chunkStart = chunk.start
        this.step()
      })
    } catch (e) {
      this.fail('goto(' + index + ')', e)
    }
  },

  // ---------------------------------------------------------------- 节点执行
  step() {
    try {
      if (!this.story) return
      let guard = 0
      while (guard++ < 3000) {
        if (this.pc >= this.story.nodeCount) { this.finishAll(); return }
        if (!this.inChunk(this.pc)) { this.prefetch(this.pc); this.goto(this.pc); return }
        const node = this.chunkNodes[this.pc - this.chunkStart]
        if (!node) { this.badge = '节点为空 ' + this.pc; return }

        if (node.bg !== undefined) this.applyBg(node.bg)
        if (node.cs !== undefined) { this.csRaw = node.cs; this.renderSprites(node.cs) }
        if (node.cg !== undefined) {
          this.cgSrc = node.cg >= 0 ? (IMG[node.cg] || '') : ''
          if (node.cg >= 0) this.markSeen(node.cg)
        }
        if (node.tint !== undefined) this.tint = node.tint

        if (node.t === 's') {
          this.updateHud(); this.prefetch(this.pc); this.trimCache(this.pc)
          this.playSay(node)
          return
        }
        if (node.t === 'o') {
          this.updateHud(); this.prefetch(this.pc); this.trimCache(this.pc)
          this.playChoice(node)
          return
        }
        if (node.t === 'e') { this.updateHud(); this.playEnd(node); return }

        if (node.t === 'f') { this.flags[node.v] = (this.flags[node.v] || 0) + node.n; this.pc++ }
        else if (node.t === 'sf') { this.flags[node.v] = node.n; this.pc++ }
        else if (node.t === 'j') { this.pc = node.j }
        else if (node.t === 'cj') { this.pc = this.testCond(node) ? node.j : this.pc + 1 }
        else this.pc++
      }
      this.badge = '节点执行超过上限，疑似死循环'
    } catch (e) {
      this.fail('step@' + this.pc, e)
    }
  },

  testCond(node) {
    const v = this.flags[node.v] || 0
    const n = node.n
    if (node.op === '>=') return v >= n
    if (node.op === '<=') return v <= n
    if (node.op === '>') return v > n
    if (node.op === '<') return v < n
    return v === n
  },

  applyBg(idx) {
    this.bgSrc = idx >= 0 ? (IMG[idx] || '') : ''
    this.showBlack = idx === -1
    this.showWhite = idx === -2
    // 换背景时从最左边重新开始扫（起点统一，不会出现"从中间开始"的怪异观感）
    this.startBgPan()
  },

  renderSprites(cs) {
    let l = '', c = '', r = ''
    for (let i = 0; i < cs.length; i++) {
      const ch = cs[i]
      const src = IMG[ch.i] || ''
      if (ch.s === 'left') l = src
      else if (ch.s === 'right') r = src
      else c = src
    }
    this.spL = l; this.spC = c; this.spR = r
  },

  // ---------------------------------------------------------------- CG 解锁记录
  markSeen(i) {
    if (!this.seenIdx) { this.seenIdx = {}; this.seenList = [] }
    if (this.seenIdx[i]) return
    this.seenIdx[i] = 1
    this.seenList.push(i)
    if (this.seenTimer) clearTimeout(this.seenTimer)
    this.seenTimer = setTimeout(() => { this.seenTimer = null; this.flushSeen() }, 500)
  },

  flushSeen() {
    if (this.seenTimer) { clearTimeout(this.seenTimer); this.seenTimer = null }
    if (this.seenList && this.seenList.length) saveSeen(this.seenList)
  },

  // ---------------------------------------------------------------- 自适应几何
  // 把 layout.js 算出的几何落成一份份 style 字符串。
  // Vela 的 CSS 是静态的，屏幕尺寸却只有运行时才知道（而且异步），
  // 所以纵向几何只能走内联 style —— 这是"一份代码适配多型号"的关键。
  applyGeometry() {
    this.lay = currentLayout()
    const L = this.lay
    const p = (v) => v + 'px'

    this.fullStyle = 'width:' + p(L.W) + ';height:' + p(L.H) + ';'
    this.bgClipStyle = 'width:' + p(L.W) + ';height:' + p(L.H) + ';'
    this.spStyleL = 'top:' + p(L.spTop) + ';left:' + p(L.spX[0]) +
      ';width:' + p(L.spW) + ';height:' + p(L.spH) + ';'
    this.spStyleC = 'top:' + p(L.spTop) + ';left:' + p(L.spX[1]) +
      ';width:' + p(L.spW) + ';height:' + p(L.spH) + ';'
    this.spStyleR = 'top:' + p(L.spTop) + ';left:' + p(L.spX[2]) +
      ';width:' + p(L.spW) + ';height:' + p(L.spH) + ';'

    this.hudStyle = 'top:' + p(L.hudTop) + ';height:' + p(L.hudH) + ';'
    this.hudTStyle = 'font-size:' + p(L.hudFont) + ';'
    this.hudPStyle = 'font-size:' + p(L.hudSubFont) + ';'
    this.mbStyle = 'top:' + p(L.mbTop) + ';left:' + p(L.mbLeft) +
      ';width:' + p(L.mbSize) + ';height:' + p(L.mbSize) +
      ';border-radius:' + p(Math.round(L.mbSize / 2)) + ';'
    this.mbIcoStyle = 'font-size:' + p(L.mbIcon) + ';'

    this.panelStyle = 'top:' + p(L.panelTop) + ';height:' + p(L.panelH) + ';'
    this.nameStyle = 'top:' + p(L.nameTop) + ';font-size:' + p(L.nameFont) + ';'
    this.moreStyle = 'bottom:' + p(L.moreBottom) + ';left:' + p(L.moreLeft) + ';'

    // 覆盖层：选项从 HUD 下方开始，菜单整屏居中
    this.choicesStyle = 'top:' + p(L.hudTop + L.hudH + 60) + ';'
    this.menuStyle = 'width:' + p(L.W) + ';height:' + p(L.H) + ';'
    this.badgeStyle = 'top:' + p(L.hudTop + L.hudH + 8) + ';'

    this.applyLayout()          // 行位置依赖几何，跟着重算
  },

  // ---------------------------------------------------------------- 排版与分页
  // 正文区宽 textW - TEXT_PAD、高 textBoxH、从 textTop 开始，行距 = 字号 + 4。
  // 分页完全在运行时按当前字号和当前屏高现算，所以字号可以无级调节，
  // 换到不同屏高的设备上每页行数也会自己变。
  layout() {
    const size = (this.settings && this.settings.size) || 20
    const m = textMetrics(this.lay, size)
    return { size: size, lineH: m.lineH, cpl: m.cpl, lpp: Math.min(MAX_LINES + 2, m.lpp) }
  },

  applyLayout() {
    const L = this.layout()
    this.s0 = this.lineStyle(0, L)
    this.s1 = this.lineStyle(1, L)
    this.s2 = this.lineStyle(2, L)
    this.s3 = this.lineStyle(3, L)
    this.s4 = this.lineStyle(4, L)
    this.s5 = this.lineStyle(5, L)
    return L
  },

  lineStyle(i, L) {
    return 'top: ' + (this.lay.textTop + i * L.lineH) + 'px; left: ' +
      this.lay.textLeft + 'px; width: ' + this.lay.textW +
      'px; font-size: ' + L.size + 'px; line-height: ' + L.lineH + 'px;'
  },

  applyFont() {
    this.applyLayout()
    this.reflow()
  },

  // 字号变了就按新字号重排当前这一句，从该句第一页重新显示
  reflow() {
    if (!this.rawText) return
    this.pages = this.paginate(this.rawText)
    this.pageIdx = 0
    this.pageText = (this.pages[0] || ['']).join('\n')
    this.typingToken++
    this.renderTyping(this.pageText.length)
  },

  // 把一句原始台词按当前排版切成 页 -> 行。
  // 真正的算法在 common/reader.js 的 paginateText()，和关于页共用同一份。
  paginate(text) {
    const L = this.layout()
    return paginateText(text, L.cpl, L.lpp)
  },

  // ---------------------------------------------------------------- 台词与打字机
  playSay(node) {
    if (this.watch) { clearTimeout(this.watch); this.watch = null }
    this.badge = ''
    this.choices = []
    this.endText = ''
    this.speaker = node.n || ''
    this.rawText = node.x || ''
    this.pages = this.paginate(this.rawText)
    this.pageIdx = 0
    this.playPage()
  },

  playPage() {
    this.clearAuto()
    this.pageText = (this.pages[this.pageIdx] || ['']).join('\n')
    this.typing = 0
    this.renderTyping(0)
    // 快速播放时整句立即显示
    const speed = this.settings.fast ? 0 : this.settings.speed
    if (!speed) { this.finishTyping(); return }
    this.typingToken++
    this.typingAt = Date.now()
    this.tickTyping(this.typingToken)
  },

  tickTyping(token) {
    if (token !== this.typingToken) return
    const speed = this.settings.fast ? 0 : this.settings.speed
    if (!speed) { this.finishTyping(); return }
    const full = this.pageText.length
    const elapsed = Math.max(0, Date.now() - this.typingAt)
    const n = Math.max(this.typing + 1, Math.floor(elapsed / speed) + 1)
    if (n >= full) { this.typing = full; this.renderTyping(full); this.finishTyping(); return }
    this.typing = n
    this.renderTyping(n)
    this.timer = setTimeout(() => this.tickTyping(token), 50)
  },

  renderTyping(n) {
    const full = this.pageText || ''
    const shown = n >= full.length ? full : full.slice(0, n)
    const seg = shown.split('\n')
    this.l0 = seg[0] || ''
    this.l1 = seg[1] || ''
    this.l2 = seg[2] || ''
    this.l3 = seg[3] || ''
    this.l4 = seg[4] || ''
    this.l5 = seg[5] || ''
    this.canTap = n >= full.length
  },

  finishTyping() {
    this.typingToken++
    if (this.timer) { clearTimeout(this.timer); this.timer = null }
    this.typing = (this.pageText || '').length
    this.renderTyping(this.typing)
    this.scheduleAuto()
  },

  scheduleAuto() {
    this.clearAuto()
    if (this.choices.length || this.endText) return
    // 快进：瞬间出字 + 220ms 连播；遇到选项/结局由上面两行自动停下。
    // 走 advance() 而不是 onTap()，否则会被 400ms 的防抖锁吃掉（见 advance 的说明）。
    if (this.settings.fast) {
      this.autoTimer = setTimeout(() => { this.autoTimer = null; this.advance() }, 220)
      return
    }
    if (!this.settings.autoMs) return
    const wait = autoDelay(this.pageText, this.settings.autoMs)
    this.autoTimer = setTimeout(() => { this.autoTimer = null; this.advance() }, wait)
  },

  clearAuto() { if (this.autoTimer) { clearTimeout(this.autoTimer); this.autoTimer = null } },
  clearTimers() {
    if (this.timer) { clearTimeout(this.timer); this.timer = null }
    if (this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null }
    this.clearAuto()
    this.stopBgPan()
    this.typingToken++
  },

  // ---------------------------------------------------------------- 屏幕常亮
  // Vela 用 @system.brightness 的 setKeepScreenOn 来保持屏幕常亮。
  // 必须在 manifest 的 features 里声明 system.brightness，否则调用会抛错。
  // 包一层 try/catch：万一某些固件没这个接口，也只是不常亮，不能让阅读崩掉。
  setKeepScreenOn(on) {
    try {
      brightness.setKeepScreenOn({ keepScreenOn: !!on })
    } catch (e) {
      this.log('设置屏幕常亮失败: ' + (e && e.message ? e.message : e))
    }
  },

  applyScreenKeepOn() {
    const s = this.settings || {}
    this.setKeepScreenOn(!!s.keepOn)
  },

  // ---------------------------------------------------------------- 全景背景
  // 每 BG_TICK_MS 把 left 推进 BG_STEP_PX，走到头再往回走，来回扫。
  // 完全不碰 CSS transition —— 那玩意在这个运行时上会渲染出接缝。
  // 背景宽图的 style = 尺寸（自适应）+ 平移偏移。
  // 尺寸和 left 必须写在同一个属性里（一个元素只能有一个 style），所以这里合成。
  bgWideStyleNow() {
    const L = this.lay
    return 'width: ' + BG_W + 'px; height: ' + L.H + 'px; left: -' +
      (this.bgOffset || 0) + 'px;'
  },

  startBgPan() {
    this.stopBgPan()
    if (!this.bgSrc) { this.bgStyle = ''; return }
    this.bgOffset = 0
    this.bgDir = 1
    this.bgStyle = this.bgWideStyleNow()
    this.bgTimer = setInterval(() => this.bgPanTick(), BG_TICK_MS)
  },

  bgPanTick() {
    if (!this.bgSrc) return
    let off = this.bgOffset + this.bgDir * BG_STEP_PX
    if (off >= BG_PAN_RANGE) { off = BG_PAN_RANGE; this.bgDir = -1 }
    else if (off <= 0) { off = 0; this.bgDir = 1 }
    this.bgOffset = off
    this.bgStyle = this.bgWideStyleNow()
  },

  stopBgPan() { if (this.bgTimer) { clearInterval(this.bgTimer); this.bgTimer = null } },

  // ---------------------------------------------------------------- 交互
  // 物理点击：先过 400ms 防抖锁（避免一次触摸被识别成两下）
  onTap() {
    if (this.lockTap && Date.now() - this.lockTap < 400) return
    this.advance()
  },

  // 真正的推进逻辑。**自动播放 / 快进也走这里，而不是 onTap()** ——
  // toggleFast() / closeMenu() 都会先 lock() 一下，
  // 而快进的定时器只有 220ms，走 onTap() 会被 400ms 的锁吃掉、而且不会重新排，
  // 链条就断了。真机上表现为「开了快进还要再点一下屏幕才开始」。
  advance() {
    if (this.endText) { router.replace({ uri: 'pages/index' }); return }
    if (this.menu || this.choices.length) return
    this.clearAuto()
    if (!this.canTap) { this.finishTyping(); return }
    if (this.pageIdx < this.pages.length - 1) { this.pageIdx++; this.playPage(); return }
    this.pc++
    this.bumpAutoSave()
    this.step()
  },

  lock() { this.lockTap = Date.now() },

  toggleImmersive() {
    if (this.menu || this.endText) return
    // 设置里可以关掉长按隐藏（防误触）。关掉后长按什么也不做。
    const s = this.settings || {}
    if (s.longpress === false) return
    this.lock()
    this.uiHidden = !this.uiHidden
    this.clearAuto()
  },

  blockSwipe() {},

  openMenu() { this.lock(); this.menu = true; this.clearAuto() },
  closeMenu() { this.lock(); this.menu = false; this.scheduleAuto() },

  toggleAuto() {
    this.lock()
    const s = Object.assign({}, this.settings)
    // autoMs 为 0 表示自动播放关闭；打开时给一个默认停留
    s.autoMs = s.autoMs > 0 ? 0 : AUTO_DEFAULT
    if (s.autoMs > 0) s.fast = false   // 自动播放与快速播放互斥，避免两个定时器打架
    this.settings = s
    this.autoOn = s.autoMs > 0
    this.fastOn = !!s.fast
    saveSettings(s)
    this.menu = false
    this.scheduleAuto()
  },

  toggleFast() {
    this.lock()
    const s = Object.assign({}, this.settings)
    s.fast = !s.fast
    if (s.fast) s.autoMs = 0
    this.settings = s
    this.autoOn = s.autoMs > 0
    this.fastOn = !!s.fast
    saveSettings(s)
    this.menu = false
    this.scheduleAuto()
  },

  nextChapter() {
    this.lock()
    this.menu = false
    if (!this.story) return
    // 跳过结局章；后日谈没通关也不给跳（否则等于剧透）
    const list = this.story.chapters
    let i = this.chapterIndex() + 1
    while (i < list.length && (list[i].hide || (list[i].need && !this.cleared))) i++
    const nx = list[i]
    if (!nx) { prompt.showToast({ message: '已经是最后一章' }); this.scheduleAuto(); return }
    this.goto(nx.start)
  },

  goSave() {
    this.lock()
    this.menu = false
    storage.set({
      key: 'pendingSave',
      value: JSON.stringify(this.collectSave()),
      success: () => router.push({ uri: 'pages/saves', params: { mode: 'save' } }),
      fail: () => { this.badge = '无法准备存档' }
    })
  },
  goLoad() { this.lock(); this.menu = false; this.flushSeen(); router.push({ uri: 'pages/saves', params: { mode: 'load' } }) },
  goChapters() { this.lock(); this.menu = false; this.flushSeen(); router.push({ uri: 'pages/chapters' }) },
  goCg() { this.lock(); this.menu = false; this.flushSeen(); router.push({ uri: 'pages/cg' }) },
  goSettings() { this.lock(); this.menu = false; router.push({ uri: 'pages/settings' }) },
  goHome() { this.lock(); this.flushAutoSave(); this.flushSeen(); router.replace({ uri: 'pages/index' }) },
  quit() { this.lock(); this.flushAutoSave(); this.flushSeen(); this.$app.exit() },

  // ---------------------------------------------------------------- 结局 / 分支
  playEnd(node) {
    this.clearTimers()
    if (this.watch) { clearTimeout(this.watch); this.watch = null }
    this.badge = ''
    this.choices = []
    this.endText = node.x || '剧终'
    // 走到终点时 true_end_finish 为 1，说明这一周目通的是真结局 → 记下通关
    if (this.flags && this.flags.true_end_finish === 1) {
      this.cleared = true
      markCleared()
    }
    saveAutoSave(this.collectSave())
  },

  finishAll() { this.playEnd({ x: '—— 全剧终 ——' }) },

  playChoice(node) {
    this.clearAuto()
    if (this.watch) { clearTimeout(this.watch); this.watch = null }
    this.badge = ''
    this.l0 = ''; this.l1 = ''; this.l2 = ''; this.l3 = ''; this.l4 = ''; this.l5 = ''
    this.speaker = ''
    this.pageText = ''
    this.rawText = ''
    this.canTap = false
    const out = []
    const opts = node.o || []
    for (let i = 0; i < opts.length; i++) {
      const o = opts[i]
      if (o.c && !this.testCond({ v: o.c[0], op: o.c[1], n: o.c[2] })) continue
      out.push({ x: o.x, j: o.j })
    }
    this.choices = out
  },

  pickChoice(idx) {
    this.lock()
    const c = this.choices[idx]
    if (!c) return
    this.choices = []
    this.pc = c.j
    this.bumpAutoSave()
    this.step()
  },

  // ---------------------------------------------------------------- 自动存档
  bumpAutoSave() {
    this.advanceCount++
    if (this.advanceCount < 8) return
    this.advanceCount = 0
    if (this.saveTimer) clearTimeout(this.saveTimer)
    this.saveTimer = setTimeout(() => { this.saveTimer = null; this.flushAutoSave() }, 400)
  },

  flushAutoSave() {
    if (this.saveTimer) { clearTimeout(this.saveTimer); this.saveTimer = null }
    if (!this.story || !this.pc) return
    this.advanceCount = 0
    saveAutoSave(this.collectSave())
  }
}
</script>
