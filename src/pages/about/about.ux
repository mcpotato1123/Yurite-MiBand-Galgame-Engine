<template>
  <div class="page" style="{{pageStyle}}" onswipe="ban">
    <!-- 彩蛋触发点：连点「关于」7 次 -->
    <text class="title" onclick="tapTitle" onswipe="ban">关于</text>
    <text class="dots">{{dots}}</text>
    <text class="sub">Yurite · {{device}} · v{{ver}}</text>

    <list id="about-list" class="lst" style="{{listStyle}}" bounces="true" onswipe="ban">
      <list-item class="item" for="{{rows}}" tid="ab">
        <div class="card">
          <text class="{{$item.c}}">{{$item.t}}</text>
        </div>
      </list-item>
    </list>

    <div class="back" style="{{backStyle}}" onclick="back" onswipe="ban"><text class="btn-t">返回</text></div>

    <!-- 彩蛋菜单 -->
    <div class="mask" style="{{maskStyle}}" if="{{eggOpen}}"></div>
    <div class="egg" style="{{eggStyle}}" if="{{eggOpen}}">
      <text class="egg-t">？？？</text>
      <div class="egg-b" onclick="unlockAfter" onswipe="ban"><text class="egg-bt">解锁 · 通关奖励</text></div>
      <div class="egg-b" onclick="unlockCg" onswipe="ban"><text class="egg-bt">解锁 · 全部 CG</text></div>
      <div class="egg-b egg-c" onclick="closeEgg" onswipe="ban"><text class="egg-bt">关闭</text></div>
    </div>
  </div>
</template>

<style>
  /* ⚠️ 下面写死的 top / height 只是**内联样式没生效时的兜底**（= 手环 9 Pro 的值）。
     真正的纵向几何由 common/layout.js 按运行时探到的屏幕比例算出，见 applyGeometry()。
     336×480 上两者逐像素相同，Pro 的观感不变。
     本页标题贴顶、返回按钮贴底、列表吃中间的剩余高度。 */
  .page { width: 336px; height: 480px; background-color: #14101a; position: relative; }
  .title { position: absolute; top: 4px; left: 0px; width: 336px; text-align: center;
           font-size: 22px; color: #ffd8e6; font-weight: bold; }
  .dots { position: absolute; top: 10px; left: 286px; width: 40px; font-size: 15px;
          color: #ff9ec4; }
  .sub { position: absolute; top: 36px; left: 0px; width: 336px; text-align: center;
         font-size: 12px; color: #9c8f9b; }

  /* 关于页是一个可滚动的文本页：<list> 的每一行固定 25px。
     三种行样式高度完全一致（只改颜色），避免条目高度不一致导致排版错乱。
     高度不能写死 366 —— 那是 480 高度下的剩余空间。列表上下各有一块固定内容
     （标题区 58、返回按钮区 56），所以可视高 = 设计高 - 114，
     336×824 上就能一屏显示 28 行而不是 14 行。
     Vela 的硬性要求：list 必须给显式宽高，所以宽高两个都写。 */
  .lst { position: absolute; top: 58px; left: 0px; width: 336px; height: 366px; }
  .item { width: 336px; height: 25px; }
  .card { width: 336px; height: 25px; flex-direction: row; align-items: center;
          padding-left: 14px; }
  .r-p { width: 308px; font-size: 15px; color: #d9cdd6; lines: 1; }
  .r-s { width: 308px; font-size: 15px; color: #ffb3cd; lines: 1; }
  .r-g { width: 308px; font-size: 6px; color: #14101a; }

  /* 返回按钮贴底：top = 设计高 - 48（= 按钮高 40 + 底边距 8） */
  .back { position: absolute; top: 432px; left: 50px; width: 236px; height: 40px;
          border-radius: 20px; background-color: #32243a;
          align-items: center; justify-content: center; }
  .btn-t { font-size: 19px; color: #ffffff; }

  /* 彩蛋菜单 */
  /* 遮罩必须铺满整个设计空间，否则高屏上会露出下半截页面 */
  .mask { position: absolute; top: 0px; left: 0px; width: 336px; height: 480px;
          background-color: rgba(8, 6, 10, 0.72); }
  /* 彩蛋框高固定 212，纵向居中：top = (设计高 - 212) / 2（480 时正好还是 132） */
  .egg { position: absolute; top: 132px; left: 32px; width: 272px; height: 212px;
         background-color: #241c2c; border-radius: 18px; flex-direction: column;
         align-items: center; padding-top: 14px; }
  .egg-t { font-size: 17px; color: #7ee8e0; margin-bottom: 12px; }
  .egg-b { width: 216px; height: 40px; border-radius: 20px; background-color: #3a2b45;
           align-items: center; justify-content: center; margin-bottom: 8px; }
  .egg-c { background-color: #2a2033; margin-top: 4px; }
  .egg-bt { font-size: 17px; color: #ffffff; }
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { wrapText, markCleared, saveSeen } from '../../common/reader.js'
import { CGG } from '../../common/cglist.js'
import { currentLayout, onLayoutReady, currentModelLabel } from '../../common/geo.js'

// 显示在副标题里的版本号。必须和 src/manifest.json 的 versionName 一致，
// tools/build.js 的构建前检查会核对，不一致直接拒绝构建。
const APP_VER = '1.0'

// 每一行的字符数。字号 15、可用宽 308 → floor(308/15)=20，取 20 保证不折行。
// 行宽由 .r-p / .r-s 的 width 固定，不随屏高变化，所以这个值也不用按型号改。
const CPL = 20

// 列表上下两块固定内容的高度：标题区 58（副标题底 48 + 10 间距）与返回按钮区 56。
// 列表高度 = 设计高 - 这两块，屏越高能显示的行越多。
const LIST_TOP = 58
const LIST_BOTTOM = 56
const BACK_H = 40            // 返回按钮高，贴底留 8
const BACK_GAP = 8
const EGG_H = 212            // 彩蛋框高，纵向居中

// 关于页正文。's' = 小节标题，'p' = 正文，'g' = 空行。
// 这里写的是原始段落，具体断行交给 common/reader.js 的 wrapText()，
// 和正文页共用同一套逻辑。
const ABOUT = [
  ['s', '关于这个引擎'],
  ['p', 'Yurite 是一个跑在穿戴设备上的 Galgame 引擎。版面由引擎在运行时按屏幕算，'],
  ['p', '你只需要提供剧本和图片。'],
  ['g', ''],
  ['p', '这里换成你自己作品的介绍 —— 世界设定、登场角色、你想说的话。'],
  ['g', ''],
  ['g', ''],
  ['s', '支持的设备'],
  ['p', '小米手环 9 / 10 标准版、小米手环 9 Pro / 10 Pro、REDMI Watch 5 / 6。'],
  ['g', ''],
  ['p', '引擎会自动识别设备并给出对应版面；认不出的设备也能跑，只是没有针对性微调。'],
  ['g', ''],
  ['s', '版权信息'],
  ['p', '这里写你自己的版权声明与致谢。'],
  ['g', ''],
          ['p', '这里写你的版权信息与致谢。'],
  ['g', ''],
  ['p', '素材仅用于学习与交流，请勿用于任何商业用途。如有侵权，请联系删除。'],
  ['g', ''],
  ['s', '开源协议'],
  ['p', '本项目代码基于 MIT 协议开源，详见仓库根目录的 LICENSE 文件。'],
  ['g', ''],
  ['p', 'Copyright (c) 2026 The Yurite Band Project Contributors'],
]

export default {
  // 统一用 protected，不要用 data（两者不能共存，运行时会抛错）
  protected: {
    rows: [],
    ver: APP_VER,
    // 运行时**识别出来的型号**（common/models.js 按屏幕尺寸 + 型号字符串认）。
    // 认不出的设备会显示成「未知设备 宽×高」—— 那种情况下引擎走的是按比例推导的
    // 兜底版面，照样能跑，只是没有针对该型号的微调。
    device: currentModelLabel(),
    dots: '',
    eggOpen: false,

    // —— 自适应几何：由 common/layout.js 按屏幕实际尺寸算出（设计坐标，宽恒 336）
    lay: currentLayout(),
    pageStyle: '', listStyle: '', backStyle: '', maskStyle: '', eggStyle: ''
  },

  onInit() {
    // 自适应几何：先用当前已知的屏幕尺寸排一次，异步探测回来后再排一次。
    // 放最前面，后面依赖几何的初始化才能用上。
    this.applyGeometry()
    // 屏幕探测是异步的，认出来的型号可能晚一步才确定，所以这里也刷新一次名字
    onLayoutReady(() => { this.applyGeometry(); this.device = currentModelLabel() })

    this.tapCount = 0
    this.lastTap = 0
    this.lockTap = 0
    this.build()
  },

  // ---------------------------------------------------------------- 自适应几何
  // Vela 的 CSS 是静态的，屏幕尺寸却只有运行时才知道（而且异步），
  // 所以纵向几何只能走内联 style —— 这是"一份代码适配多型号"的关键。
  applyGeometry() {
    this.lay = currentLayout()
    const L = this.lay
    const p = (v) => v + 'px'

    // ⚠️ 用视口百分比，**不要**用算出来的 W/H：
    // 一旦引擎算的尺寸和运行时真实视口不同源，页面就会被当成可滚动内容
    // （红米手表上表现为「界面能上下滑」）。100% 相对的是视口，与数值无关。
    this.pageStyle = 'width:100%;height:100%;'
    // 列表可视高 = 设计高 - 上固定块 - 下固定块（必须显式给宽高，Vela 的硬性要求）
    this.listStyle = 'width:' + p(L.W) + ';height:' + p(Math.max(25, L.H - LIST_TOP - LIST_BOTTOM)) + ';'
    this.backStyle = 'top:' + p(L.H - BACK_H - BACK_GAP) + ';'
    this.maskStyle = 'width:' + p(L.W) + ';height:' + p(L.H) + ';'
    // 彩蛋框宽固定 272、水平居中；纵向居中
    this.eggStyle = 'top:' + p(Math.max(0, Math.round((L.H - EGG_H) / 2))) +
      ';left:' + p(Math.round((L.W - 272) / 2)) + ';'
  },

  build() {
    const rows = []
    for (let i = 0; i < ABOUT.length; i++) {
      const kind = ABOUT[i][0]
      const txt = ABOUT[i][1]
      if (kind === 'g') { rows.push({ c: 'r-g', t: '' }); continue }
      const cls = kind === 's' ? 'r-s' : 'r-p'
      const parts = wrapText(txt, CPL)
      for (let j = 0; j < parts.length; j++) rows.push({ c: cls, t: parts[j] })
    }
    this.rows = rows
  },

  ban() {},
  lock() { this.lockTap = Date.now() },

  // ---- 彩蛋：2 秒内连点「关于」7 次
  tapTitle() {
    const now = Date.now()
    if (now - this.lastTap > 2000) this.tapCount = 0
    this.lastTap = now
    this.tapCount++
    if (this.tapCount >= 7) {
      this.tapCount = 0
      this.dots = ''
      this.eggOpen = true
      return
    }
    // 从第 4 次开始给一点点提示，不然完全看不出有反应
    const DOTS = ['', '·', '··', '···']
    this.dots = this.tapCount >= 4 ? DOTS[Math.min(3, this.tapCount - 3)] : ''
  },

  closeEgg() { this.lock(); this.eggOpen = false },

  // 解锁通关奖励：写 cleared 标记，章节选择里就会出现「通关奖励
  unlockAfter() {
    this.lock()
    this.eggOpen = false
    markCleared(() => {
      prompt.showToast({ message: '已解锁「通关奖励' })
    })
  },

  // 解锁全部 CG：把 cglist.js 里所有出现过的图片下标一次写进 cgSeen
  unlockCg() {
    this.lock()
    this.eggOpen = false
    const all = []
    for (let i = 0; i < CGG.length; i++) {
      const im = CGG[i].im || []
      for (let j = 0; j < im.length; j++) {
        if (all.indexOf(im[j]) < 0) all.push(im[j])
      }
    }
    saveSeen(all, () => {
      prompt.showToast({ message: '已解锁全部 CG（' + all.length + ' 张）' })
    })
  },

  back() { this.lock(); router.back() }
}
</script>
